# Backend environment. Copy to backend/.env for local development (gitignored).
# PLACEHOLDERS ONLY: never commit real values. On Render, set these as environment variables / secrets.

# --- General -----------------------------------------------------------------------------------
UPLOAD_CACHE_DIR=
# Comma-separated origins allowed to call the API from a browser (GitHub Pages site), e.g.
# https://<user>.github.io  (origin only: no path). Leave empty for local dev (Vite proxy).
CORS_ALLOWED_ORIGINS=

# --- Benchmark mode: kill switch, auth, storage ---------------------------------------------------
# Kill switch: cloud submissions are refused unless this is 1. Local packages always work.
BENCH_CLOUD_ENABLED=0
# sdk = real Nebius Serverless Jobs; fake = SIMULATED provider for tests/demos (labelled in the UI).
BENCH_NEBIUS_BACKEND=sdk
# Demo password (Render secret). Long random value; share out of band.
BENCH_DEMO_PASSWORD=change-me
# HMAC key for session tokens (Render secret), e.g. `python -c "import secrets;print(secrets.token_urlsafe(48))"`
BENCH_SESSION_SECRET=change-me
BENCH_SESSION_TTL_MINUTES=60
BENCH_LOGIN_MAX_ATTEMPTS=5
BENCH_LOGIN_WINDOW_SECONDS=900
# Durable storage. Render: a persistent disk path (sqlite:////var/data/bench.sqlite3) or Render Postgres
# (postgresql://...). Render's default filesystem and memory are wiped on deploy/restart.
BENCH_DATABASE_URL=sqlite:///./benchmark_dev.sqlite3

# --- Benchmark mode: limits and allowances (USD figures are reservations, not Nebius billing caps) ---
BENCH_SESSION_ALLOWANCE_USD=5
BENCH_GLOBAL_ALLOWANCE_USD=20
# Rate used for reservations and estimated charges (set >= your real on-demand 1-GPU price).
BENCH_RESERVATION_USD_PER_GPU_HOUR=6
BENCH_RUNNER_MAX_SECONDS=300
BENCH_STARTUP_GRACE_SECONDS=900
# Nebius job timeout backstop, whole hours (minimum 1).
BENCH_PLATFORM_TIMEOUT_HOURS=1
BENCH_POLL_MIN_INTERVAL_SECONDS=10
BENCH_MEMORY_SAFETY_FRACTION=0.10
# User-facing cancel button; enable after verifying cancel semantics on a live job.
BENCH_CANCEL_ENABLED=0
BENCH_PREEMPTIBLE=0
# platform:1-GPU-preset pairs that jobs may use.
BENCH_ALLOWED_PLATFORMS=gpu-h100-sxm:1gpu-16vcpu-200gb,gpu-h200-sxm:1gpu-16vcpu-200gb,gpu-l40s-a:1gpu-8vcpu-32gb,gpu-l40s-d:1gpu-16vcpu-96gb
# Immutable image reference (digest), see benchmark/README.md.
BENCH_IMAGE=cr.<region>.nebius.cloud/<registry-id>/compute-cast-bench@sha256:<digest>

# --- Nebius (restricted benchmark service account; NOT a Token Factory key) -----------------------
NEBIUS_PROJECT_ID=project-<id>
# Path to the service account credentials JSON (Render secret file, e.g. /etc/secrets/nebius-credentials.json).
NEBIUS_CREDENTIALS_FILE=/etc/secrets/nebius-credentials.json
# Results bucket: ID for the job volume mount, name for S3 reads.
NEBIUS_RESULTS_BUCKET_ID=storagebucket-<id>
NEBIUS_RESULTS_BUCKET_NAME=<bucket-name>
NEBIUS_RESULTS_PREFIX=compute-cast-benchmarks
NEBIUS_S3_ENDPOINT=https://storage.<region>.nebius.cloud
NEBIUS_S3_REGION=<region>
# Read-only access key for the results bucket (Render secret).
NEBIUS_S3_ACCESS_KEY_ID=
NEBIUS_S3_SECRET_ACCESS_KEY=
# Optional: MysteryBox secret version holding REGISTRY_USERNAME / REGISTRY_PASSWORD for a private registry.
NEBIUS_REGISTRY_SECRET_VERSION=
