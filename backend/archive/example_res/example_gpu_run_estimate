  "formula_catalog": {
    "schedule": {
      "formula": "samples/rank=ceil(N/D) (or floor with sampler_drop_last); microbatches/epoch=ceil(samples/rank/B) (or floor with loader drop_last); updates/epoch=ceil(microbatches/epoch/accumulation)",
      "basis": "Balanced DistributedSampler-like sharding and flush-at-epoch-end policy. In max_steps mode, microbatches=max_steps*accumulation. Nominal full batch shapes are costed even for the final partial batch.",
      "sources": [
        "sampler"
      ]
    },
    "gemm": {
      "formula": "FLOPs=2*M*N*K",
      "basis": "One multiply-add counted as two FLOPs.",
      "sources": [
        "gemm"
      ]
    },
    "mlp": {
      "formula": "forward=2*B*(I*H+H*O); forward+backward=4*B*I*H+6*B*H*O",
      "basis": "Original GEMM count for full training, no input gradient: first weight gradient and second weight/input gradients. Add 2*B*I*H when input_requires_grad=true. Bias, ReLU and loss arithmetic omitted (traffic/latency still budgeted).",
      "sources": [
        "gemm"
      ]
    },
    "transformer": {
      "formula": "forward=L*(2*B*S*H*(H+2*KV)+2*B*S*H*H+2*projections*B*S*H*I+4*B*S*S*H*attention_pair_fraction)+2*B*S*H*V; forward+backward~=3*forward; KV=H*kv_heads/heads",
      "basis": "GEMM-based extension of conventional transformer accounting to GQA and gated MLPs. Fully trainable, full-token vocabulary projection. Softmax/norm/embedding scatter arithmetic omitted. 2 projections=ordinary MLP, 3=gated. Causal mask does not automatically halve GEMM work. This is NOT universal 6*parameter_count for arbitrary architectures.",
      "sources": [
        "gemm",
        "transformer"
      ]
    },
    "checkpoint": {
      "formula": "extra FLOPs = recompute_forward_fraction * forward_FLOPs",
      "basis": "Recomputed forward operations; full layer checkpointing defaults to fraction=1 when enabled without an explicit fraction. Selective checkpointing needs its own fraction. Optimizer FLOPs are not multiplied.",
      "sources": [
        "transformer"
      ]
    },
    "traffic": {
      "formula": "HBM proxy=3*weight_bytes+6*activation_proxy_elements*activation_bytes",
      "basis": "UNSOURCED rough traffic proxy for repeat reads/writes. Not resident VRAM and not a cache/kernel-level traffic simulation. Explicit hbm_bytes_per_microbatch overrides it.",
      "sources": []
    },
    "roofline": {
      "formula": "core_seconds=max(FLOPs/(peak_FLOPs*arithmetic_efficiency), HBM_bytes/(peak_HBM_bandwidth*bandwidth_efficiency))",
      "basis": "Whole-microbatch roofline approximation. Efficiencies are UNSOURCED scenario assumptions, not end-to-end measured MFU; kernel-by-kernel summation can differ.",
      "sources": [
        "roofline"
      ]
    },
    "optimizer": {
      "formula": "HBM bytes/update~=2*weights+gradients+2*optimizer_states+2*extra_master; update time=max(optimizer_FLOPs/effective_FP32_FLOPs,bytes/effective_HBM_bandwidth)",
      "basis": "Read/write tensor accounting plus UNSOURCED arithmetic allowance: SGD 4, SGD+momentum 6, Adam/AdamW 16, Adagrad 8, RMSprop 12 FLOPs/parameter. Sharded updates operate on local owned parameters. CPU offload needs explicit CPU update time; GPU specifications cannot predict CPU optimizer throughput.",
      "sources": [
        "zero"
      ]
    },
    "communication": {
      "formula": "ring allreduce bytes/rank=2*(D-1)/D*gradient_bytes; allgather/reduce-scatter bytes/rank=(D-1)/D*payload; time=bytes/effective_link_Bps+latency",
      "basis": "Ring-equivalent traffic. DDP sync defaults to every microbatch unless synchronize_each_microbatch=false. ZeRO1/2 also budget updated-weight gather; ZeRO3/full FSDP budget two weight gathers per microbatch. Exact collective schedule and effective topology require overrides/calibration.",
      "sources": [
        "collectives",
        "zero"
      ]
    },
    "io": {
      "formula": "seconds=transferred_bytes/effective_bytes_per_second + preprocessing_seconds",
      "basis": "Disk compressed bytes and CPU-GPU decoded bytes treated separately. Sequential disk specs discounted by configurable efficiency. Per-rank storage share is assumed to be node bandwidth/gpus_per_node. No remote-storage speed is inferred.",
      "sources": []
    },
    "overlap": {
      "formula": "combined(a,b)=a+b-overlap_fraction*min(a,b)",
      "basis": "UNSOURCED pipeline approximation: 0=sum, 1=max. Data/communication/offload overlap settings are assumptions, not measured scheduling behavior.",
      "sources": []
    },
    "total": {
      "formula": "training=microbatch_count*microbatch_seconds+update_count*update_seconds; job=training+evaluation+checkpoint+startup; GPU-hours=world_size*training_seconds/3600",
      "basis": "Elapsed-time accounting for balanced synchronous ranks, not sum of GPU times. All GPUs assumed allocated for the entire job. Queue time excluded.",
      "sources": []
    }
  },
  "assumptions": [
    "Epoch mode flushes partial accumulation at each epoch end. Final partial batches use nominal full-batch compute; sampler may pad/duplicate examples.",
    "MLP profile is full Linear-ReLU-Linear training. Bias/ReLU/loss FLOPs omitted; launch count 12 and traffic proxy are unsourced planning approximations.",
    "Default HBM traffic is 3*weight_bytes+6*activation-proxy bytes; this UNSOURCED heuristic is not peak VRAM or measured memory traffic.",
    "Optimizer arithmetic/launch counts are heuristic. Traffic counts read/write weights, gradients, moments and extra master copies. Frozen/trainable mixed weight dtypes need explicit per-rank overrides.",
