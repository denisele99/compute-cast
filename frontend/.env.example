# Frontend build settings (public; never put secrets here, everything VITE_* ships to the browser).
# Copy to .env.local for local overrides.

# Backend origin for a GitHub Pages build, e.g. https://compute-cast-api.onrender.com
# Leave empty in local development: Vite proxies /api to http://127.0.0.1:8000.
VITE_API_BASE_URL=

# Base path of the GitHub Pages site, e.g. /compute-cast/ for https://<user>.github.io/compute-cast/
VITE_BASE_PATH=/
