{
  "schema_version": 2,
  "scope": "distributed_and_offloaded_dense_training",
  "scenario_interpretation": "Per-rank planning scenarios for balanced identical ranks. No statistical bounds, transfer-time forecast or actual framework execution.",
  "formula_catalog": {
    "tensor_bytes": {
      "formula": "numel * bytes_per_element; numel = product(shape)",
      "basis": "Dense tensor storage accounting, excluding aliasing, padding and metadata.",
      "sources": [
        "tensor_size"
      ]
    },
    "model_states": {
      "formula": "weights + buffers + P_trainable*b_grad + optimizer_states + extra_master_weights",
      "basis": "Sum of separately stored dense tensors; not an extra universal bytes/parameter constant.",
      "sources": [
        "tensor_size",
        "adamw",
        "amp"
      ]
    },
    "optimizer_states": {
      "formula": "sum_over_groups(P_group * state_count * b_state)",
      "state_counts": {
        "sgd": "1 if momentum>0 else 0",
        "adam_adamw": "2 + int(amsgrad)",
        "adagrad": "1",
        "rmsprop": "1 + int(momentum>0) + int(centered)"
      },
      "basis": "Derived by counting algorithm state buffers. Assumes one shared state dtype; all trainable parameters optimized and eventually receive gradients. Tiny per-tensor step counters omitted unless an explicit override includes them.",
      "sources": [
        "sgd",
        "adam",
        "adamw",
        "adagrad",
        "rmsprop"
      ]
    },
    "master_weights": {
      "formula": "P_trainable * 4 if an ADDITIONAL FP32 master copy exists; otherwise 0",
      "basis": "Tensor accounting, conditioned on implementation. FP32 model parameters are not counted a second time merely because autocast is enabled.",
      "sources": [
        "tensor_size",
        "amp"
      ]
    },
    "autocast_cache": {
      "formula": "eligible_FP32_parameters * lower_precision_bytes",
      "basis": "Potential additional cast-weight storage, distinct from a master copy; assumes all FP32 trainable parameters eligible when low-precision compute is configured. Explicit override can correct cache policy and eligibility.",
      "sources": [
        "amp"
      ]
    },
    "mlp_saved": {
      "formula": "B * (input_features + hidden_features) * activation_bytes",
      "basis": "Original tensor-inventory derivation for Linear-ReLU-Linear. Save the first linear input and ReLU output; shared saved storage counted once. Weights excluded; original input is not added again if it aliases the saved input. Assumes full training and ordinary PyTorch eager autograd.",
      "sources": [
        "autograd",
        "derivatives",
        "tensor_size"
      ]
    },
    "transformer_saved": {
      "formula": "L*B*S*H*(34 + 5*A*S/H) = 34*L*B*S*H + 5*L*B*A*S*S bytes",
      "basis": "Korthikanti et al., 2022, Section 4.1, Equation 1, multiplied by L. Single-stack conventional MHA; 4H GeLU feed-forward, dropout, 16-bit activations plus one-byte masks; no checkpointing. Excludes output/loss. Not applied to FlashAttention, GQA, gated MLPs or FP32.",
      "sources": [
        "transformer"
      ]
    },
    "auxiliary": {
      "formula": "extra_input_bytes + output_elements*b_output + loss_buffer_allowance",
      "basis": "Tensor-size derivation. For MLP: prediction B*O elements; target and original input from specs, excluding saved-input alias. For token LM: logits B*S*V. Loss allowance is HEURISTIC: 1/2 extra FP32 output-sized buffers in the low/high scenarios (at least FP32 for MSE); not a universal loss implementation formula.",
      "sources": [
        "tensor_size",
        "autograd"
      ]
    },
    "optimizer_workspace": {
      "formula": "low = largest_parameter_numel*max(b_state,b_weight); high = low + total_trainable_weight_bytes if foreach enabled/unknown, otherwise low (unless explicitly overridden)",
      "basis": "Engineering allowance for scratch. PyTorch documents approximately sizeof(params) ADDITIONAL peak memory for foreach vs for-loop. The largest parameter allowance is UNSOURCED heuristic, not a bound on for-loop/fused.",
      "sources": [
        "adam"
      ]
    },
    "kernel_workspace": {
      "formula": "fixed_workspace + fraction*(saved_activations + auxiliary_tensors)",
      "basis": "UNSOURCED configurable heuristic. No universal metadata-only kernel workspace formula. Defaults are example planning values, not measured limits.",
      "sources": []
    },
    "planning_total": {
      "formula": "T = states + cast_cache + extra_state + activations + auxiliary + kernel_workspace + optimizer_workspace; total = T*(1+fragmentation_fraction) + runtime_overhead",
      "basis": "Original conservative co-residency planning model. Fragmentation and CUDA overhead defaults are UNSOURCED assumptions. CUDA docs explain allocated vs reserved memory, but do not prescribe these fractions. Scenario endpoints are NOT bounds, probabilities, or a measured max over execution time.",
      "sources": [
        "cuda"
      ]
    },
    "capacity": {
      "formula": "usable = total_vram - other_usage - user_safety_reserve",
      "basis": "Capacity accounting. Compare planning scenarios to usable memory. Uses explicit byte/GiB capacity, not manufacturer GB labels.",
      "sources": [
        "tensor_size"
      ]
    },
    "units": {
      "formula": "GiB = bytes / 2**30; MiB = bytes / 2**20",
      "basis": "Binary unit definitions; bandwidth GB/s is not used in this estimator.",
      "sources": []
    },
    "state_sharding": {
      "formula": "rank_state_bytes = ceil(global_state_bytes / shard_group_size) for sharded categories; otherwise global_state_bytes",
      "basis": "Ideal balanced byte partition; padding/flattening overhead not inferred. ZeRO1 shards optimizer/master; ZeRO2 also gradients; ZeRO3 also weights. FSDP FULL_SHARD uses ZeRO3-like persistent ownership. FSDP SHARD_GRAD_OP budgets full weights during compute. Buffers remain replicated. No tensor/pipeline parallel partition is guessed.",
      "sources": [
        "zero",
        "fsdp"
      ]
    },
    "state_placement": {
      "formula": "sum rank-owned state bytes by configured gpu/cpu/nvme location",
      "basis": "Steady-state storage accounting, not automatic framework configuration. Transfers also need live GPU working sets and CPU staging; these are separately budgeted. Offload is not a multiplication by zero.",
      "sources": [
        "zero"
      ]
    },
    "gather_working_set": {
      "formula": "GPU full-weight buffers = min(P, gather_unit_params * live_units)*b_weight; full-gradient work buffer = min(Pt,gather_unit_params)*b_grad",
      "basis": "Conservative allocated-buffer model. Keeps local shards AND gathered buffers, so shared storage may be overcounted. Covers current/prefetched units; does not claim to exactly reproduce DeepSpeed/FSDP allocator lifetimes. Unknown wrapping falls back to whole-model unit (reported). DeepSpeed documents largest-layer parameter+gradient working sets; FSDP documents prefetch/all-gather concurrency.",
      "sources": [
        "zero_memory",
        "fsdp"
      ]
    },
    "communication_buffers": {
      "formula": "copies * (reduce_bucket_bytes + allgather_bucket_bytes)",
      "basis": "User-configured buffer accounting. Default buckets are planning allowances capped at 25 MiB and relevant model/gradient size, not asserted framework defaults. Optional explicit bytes override. Gradient bucket views/aliasing may reduce actual extra allocation.",
      "sources": [
        "ddp",
        "zero"
      ]
    },
    "offload_staging": {
      "formula": "CPU staging: tile_params * sum(bytes/parameter for offloaded states); CPU optimizer scratch and GPU working sets budgeted separately",
      "basis": "Original tiled-transfer allowance. Defaults one simultaneous tile of min(local owned params, gather unit, 1e8 params), not actual ZeRO Infinity buffer pool defaults. Explicit byte values override; async double buffering requires correspondingly larger allowances. CPU optimizer computation is assumed when optimizer states are on CPU/NVMe.",
      "sources": [
        "zero"
      ]
    },
    "graph_liveness": {
      "formula": "graph_peak[device] = max_t(sum live unique storage bytes at t + explicit workspace bytes at t)",
      "basis": "Original interval-sweep accounting; each tensor lives on inclusive [born,last_use]. Shared storage_id is deduplicated with explicit underlying storage_bytes. Model states must be excluded. Complete forward+backward input/output/loss/activation coverage is asserted by the user, not inferred from parameter counts. Kernel workspace remains an allowance unless workspace_complete=true.",
      "sources": [
        "tensor_size",
        "autograd"
      ]
    },
    "node_memory": {
      "formula": "node_cpu = ranks_per_node * per_rank_cpu + shared_cpu; node_nvme = ranks_per_node * per_rank_nvme + shared_nvme",
      "basis": "Balanced identical-rank accounting. Shared datasets/checkpoints must be supplied separately. Node CPU includes selected graph transients, staging and optimizer workspace; not a complete OS memory forecast.",
      "sources": []
    }
  },
